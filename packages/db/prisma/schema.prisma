generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Identity ────────────────────────────────────────────────────────────────

// A user carries zero or more credentials (googleId, email+passwordHash) --
// never both a real identity AND a separate "anonymous" row for the same
// person. `isAnonymous` starts true only for the auto-provisioned guest
// path and flips to false permanently once any credential is added
// (POST /auth/claim, /auth/claim/google) -- claiming an account is always an
// in-place upgrade of this same row, specifically so account-merging (two
// User rows for one person, with separate WorkSession/GemLedgerEntry
// history) never has to exist as a feature.
model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  name         String
  avatarUrl    String?
  googleId     String?   @unique
  passwordHash String?
  isAnonymous  Boolean   @default(false)
  suspendedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  memberships      Membership[]
  teamMemberships  TeamMembership[]
  workSessions     WorkSession[]
  notes            Note[]
  sessions         Session[]
  adminUser        AdminUser?
  gemLedgerEntries GemLedgerEntry[]
  gemBalances      GemBalance[]
  gemAccounts      GemAccount[]
  activeSessions   UserActiveSession[]
  goalsCreated     Goal[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  activeTenantId String? // which tenant this session is currently scoped to
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id])
  activeTenant Tenant? @relation(fields: [activeTenantId], references: [id])

  @@index([token])
  @@index([userId])
}

model AdminUser {
  id        String    @id @default(cuid())
  userId    String    @unique
  role      AdminRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum AdminRole {
  SUPERADMIN
  SUPPORT
}

// ── Tenancy ─────────────────────────────────────────────────────────────────

model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  plan      TenantPlan @default(FREE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  memberships      Membership[]
  teams            Team[]
  projects         Project[]
  workSessions     WorkSession[]
  agentEmployees   AgentEmployee[]
  agentReports     AgentReport[]
  goals            Goal[]
  integrations     Integration[]
  googleDocLinks   GoogleDocLink[]
  discordBindings  DiscordBinding[]
  githubBindings   GithubBinding[]
  activeSessions   Session[]
  gemLedgerEntries GemLedgerEntry[]
}

enum TenantPlan {
  FREE
  TEAM
  ENTERPRISE
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Team {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  members      TeamMembership[]
  projects     Project[]
  agentReports AgentReport[]
  goals        Goal[]

  @@index([tenantId])
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ── Core work loop ──────────────────────────────────────────────────────────

model Project {
  id         String    @id @default(cuid())
  tenantId   String
  teamId     String?
  name       String
  color      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  team             Team?            @relation(fields: [teamId], references: [id])
  workSessions     WorkSession[]
  agentReports     AgentReport[]
  googleDocLinks   GoogleDocLink[]
  githubBindings   GithubBinding[]
  gemType          GemType?
  gemLedgerEntries GemLedgerEntry[]
  gemBalances      GemBalance[]
  gemAccounts      GemAccount[]
  goals            Goal[]

  @@index([tenantId])
  @@index([teamId])
}

model WorkSession {
  id                String            @id @default(cuid())
  tenantId          String
  userId            String
  projectId         String?
  goalId            String?
  name              String? // TEMP: nullable during migration backfill, tightened to required right after
  status            WorkSessionStatus @default(RUNNING)
  startedAt         DateTime          @default(now())
  stoppedAt         DateTime?
  activeDurationSec Int               @default(0)
  correctedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  user           User                  @relation(fields: [userId], references: [id])
  project        Project?              @relation(fields: [projectId], references: [id])
  goal           Goal?                 @relation(fields: [goalId], references: [id])
  intervals      WorkSessionInterval[]
  notes          Note[]
  googleDocLinks GoogleDocLink[]
  gemLedgerEntry GemLedgerEntry?
  activeGuard    UserActiveSession?

  // UserActiveSession enforces at most one non-STOPPED session per
  // (userId, projectId) pair -- a user can run several concurrent sessions
  // as long as each is on a different project (or has no project at all;
  // MySQL treats NULL as distinct in a unique index, so multiple
  // concurrent unassigned sessions are allowed too, same as two different
  // real projects would be).
  @@index([tenantId])
  @@index([userId, status])
  @@index([userId, startedAt])
  @@index([projectId])
  @@index([goalId])
}

// MySQL has no partial unique index for "one non-STOPPED WorkSession per
// (user, project)". This coordination row makes that invariant
// database-enforced: @@unique([userId, projectId]) means concurrent starts
// on the *same* project can't both commit, while starts on different
// projects (a different projectId, or another NULL -- MySQL treats each
// NULL as distinct) are unaffected. Replaces the earlier design where
// userId alone was the primary key, which only allowed one session
// globally per user.
model UserActiveSession {
  id            String   @id @default(cuid())
  userId        String
  projectId     String?
  workSessionId String   @unique
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  workSession WorkSession @relation(fields: [workSessionId], references: [id])

  @@unique([userId, projectId])
}

enum WorkSessionStatus {
  RUNNING
  PAUSED
  REVIEWING
  STOPPED
}

// Append-only active/paused boundary log a WorkSession's duration is derived
// from — duration is never trusted from the client clock.
model WorkSessionInterval {
  id            String       @id @default(cuid())
  workSessionId String
  kind          IntervalKind
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  createdAt     DateTime     @default(now())

  workSession WorkSession @relation(fields: [workSessionId], references: [id])

  @@index([workSessionId])
}

enum IntervalKind {
  ACTIVE
  PAUSED
}

model Note {
  id            String   @id @default(cuid())
  workSessionId String
  authorId      String
  body          String   @db.Text
  isStopSummary Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workSession WorkSession @relation(fields: [workSessionId], references: [id])
  author      User        @relation(fields: [authorId], references: [id])

  @@index([workSessionId, createdAt])
  @@index([authorId])
}

// ── TimeGem economy ──────────────────────────────────────────────────────────
// See docs/data-model.md for why this is ledger-shaped (one entry per
// finalized WorkSession, replayable) rather than a bare running counter.

model GemType {
  id          String   @id @default(cuid())
  projectId   String   @unique
  name        String
  icon        String
  color       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project          @relation(fields: [projectId], references: [id])
  ledgerEntries GemLedgerEntry[]
  balances      GemBalance[]
}

model GemLedgerEntry {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  projectId         String
  workSessionId     String   @unique
  gemTypeId         String
  activeDurationSec Int
  carryInSec        Int
  carryOutSec       Int
  gemsAwarded       Int
  createdAt         DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  project     Project     @relation(fields: [projectId], references: [id])
  workSession WorkSession @relation(fields: [workSessionId], references: [id])
  gemType     GemType     @relation(fields: [gemTypeId], references: [id])

  @@index([tenantId])
  @@index([userId, projectId])
  @@index([gemTypeId])
}

model GemBalance {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  gemTypeId String
  totalGems Int      @default(0)
  carrySec  Int      @default(0)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  gemType GemType @relation(fields: [gemTypeId], references: [id])

  @@unique([userId, projectId, gemTypeId])
  @@index([projectId])
  @@index([gemTypeId])
}

// Stable serialization point for every (user, project) ledger. Unlike
// GemBalance it exists independently of a GemType, so settlement, replay,
// and gem-type changes all acquire the same database row lock.
model GemAccount {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@id([userId, projectId])
  @@index([projectId])
}

// ── AI agent workforce ──────────────────────────────────────────────────────

model AgentEmployee {
  id        String            @id @default(cuid())
  tenantId  String
  kind      AgentEmployeeKind
  name      String
  enabled   Boolean           @default(true)
  schedule  String
  lastRunAt DateTime?
  config    Json              @default("{}")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  reports AgentReport[]

  @@index([tenantId])
}

enum AgentEmployeeKind {
  SUMMARIZER
  QA
  PM
  CODE_REVIEW
  STEERING
  CUSTOM
}

model AgentReport {
  id              String          @id @default(cuid())
  agentEmployeeId String
  tenantId        String
  teamId          String?
  projectId       String?
  type            AgentReportType
  title           String
  body            String          @db.Text
  postedTo        Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  agentEmployee AgentEmployee @relation(fields: [agentEmployeeId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  team          Team?         @relation(fields: [teamId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])
  goals         Goal[]

  @@index([tenantId, createdAt])
  @@index([agentEmployeeId])
  @@index([teamId])
  @@index([projectId])
}

enum AgentReportType {
  SUMMARY
  REVIEW
  PROPOSAL
  GOAL
}

// Central to project planning, not just an agent-approval inbox: a Goal can
// be scoped to a Project (planning) and WorkSessions can be tagged with one
// as they're worked (execution) -- `loggedSec` on the API response is a live
// aggregate over those sessions, not a stored field, so it can never drift.
model Goal {
  id                  String     @id @default(cuid())
  tenantId            String
  teamId              String?
  projectId           String?
  createdByUserId     String? // null for agent-authored (Steering); set for human-authored
  title               String
  description         String     @db.Text
  status              GoalStatus @default(PROPOSED)
  progressPercent     Int        @default(0) // 0-100, manually reported completeness
  complexityScore     Int        @default(3) // 1 (trivial) - 5 (very complex)
  estimatedHours      Float?
  sourceAgentReportId String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  team              Team?         @relation(fields: [teamId], references: [id])
  project           Project?      @relation(fields: [projectId], references: [id])
  createdBy         User?         @relation(fields: [createdByUserId], references: [id])
  sourceAgentReport AgentReport?  @relation(fields: [sourceAgentReportId], references: [id])
  workSessions      WorkSession[]

  @@index([tenantId, status])
  @@index([projectId])
}

enum GoalStatus {
  PROPOSED
  ACTIVE
  DONE
  DROPPED
}

// ── Integrations ─────────────────────────────────────────────────────────────

model Integration {
  id          String            @id @default(cuid())
  tenantId    String
  kind        IntegrationKind
  status      IntegrationStatus @default(DISCONNECTED)
  credentials Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kind])
}

enum IntegrationKind {
  GOOGLE
  DISCORD
  GITHUB
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model GoogleDocLink {
  id            String    @id @default(cuid())
  tenantId      String
  workSessionId String?
  projectId     String?
  docId         String
  docUrl        String
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  workSession WorkSession? @relation(fields: [workSessionId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])

  @@index([tenantId])
}

model DiscordBinding {
  id        String   @id @default(cuid())
  tenantId  String
  guildId   String
  channelId String
  postTypes Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model GithubBinding {
  id              String   @id @default(cuid())
  tenantId        String
  installationId  String
  repoFullName    String
  linkedProjectId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  linkedProject Project? @relation(fields: [linkedProjectId], references: [id])

  @@index([tenantId])
}
